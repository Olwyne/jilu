rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
      allow read: if resource.data.settings.publicProfile == true;

      match /works/{workId} {
        allow read, write: if isOwner(uid);
        allow read: if get(/databases/$(database)/documents/users/$(uid)).data.settings.publicProfile == true;
      }
      match /watched/{workId} {
        allow read, write: if isOwner(uid);
        allow read: if get(/databases/$(database)/documents/users/$(uid)).data.settings.publicProfile == true;
      }

      // Modèle v2 : un document par œuvre suivie, privé à son propriétaire
      match /library/{workId} {
        allow read, write: if isOwner(uid);
      }
      match /migrations/{id} {
        allow read, write: if isOwner(uid);
      }
    }

    // Catalogue partagé : création seule (jamais de modification par un utilisateur).
    // Les fiches « local-{uid}-… » ne peuvent être créées que par leur propriétaire.
    match /catalog/{catalogId} {
      function validCatalog(d) {
        return d.title is string && d.title.size() > 0 && d.title.size() <= 300
          && d.category is string
          && d.keys().size() <= 40;
      }
      allow read: if signedIn();
      allow create: if signedIn() && validCatalog(request.resource.data)
        && (!catalogId.matches('^local-.*')
            || catalogId.matches('^local-' + request.auth.uid + '-.*'));
      allow update, delete: if false;
    }

    // Un pseudo ne peut être créé que s'il est libre, jamais réécrit par un autre
    // utilisateur. Pour en changer : supprimer l'ancien + créer le nouveau (batch).
    match /pseudos/{handle} {
      allow read: if true;
      allow create: if signedIn()
        && handle.matches('^[a-z0-9_]{2,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /reviews/{reviewId} {
      function validReview(d) {
        return d.workId is string && d.workId.size() > 0 && d.workId.size() <= 200
          && d.userId == request.auth.uid
          && d.text is string && d.text.size() <= 20000
          && (d.rating == null || (d.rating is int && d.rating >= 0 && d.rating <= 5))
          && d.handle is string && d.handle.size() <= 20
          && (d.handle == 'Anonyme'
              || get(/databases/$(database)/documents/pseudos/$(d.handle.lower())).data.uid == request.auth.uid)
          && d.ts is number;
      }

      allow read: if signedIn();
      allow create: if signedIn() && validReview(request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.workId == resource.data.workId
        && validReview(request.resource.data);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Un seul score par jour et par utilisateur (création uniquement).
    // La bonne réponse n'étant connue que du client, `correct` reste déclaratif.
    match /quiz/{date}/scores/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.answer is int
        && request.resource.data.answer >= 0 && request.resource.data.answer <= 3
        && request.resource.data.correct is bool
        && request.resource.data.timeMs is number
        && request.resource.data.timeMs >= 300
        && request.resource.data.handle is string
        && request.resource.data.handle.size() <= 40;
      allow delete: if isOwner(userId);
    }

    match /follows/{uid} {
      allow read, write: if isOwner(uid);
    }
  }
}
